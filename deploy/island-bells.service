[Unit]
Description=岛屿铃钱记 — FastAPI Backend (MySQL)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/island_bells/backend

# 从 .env 文件加载环境变量
EnvironmentFile=/opt/island_bells/deploy/.env
Environment=APP_ENV=prod

# 日志目录
LogsDirectory=island_bells

# 必须单 worker: WS 连接管理器与房间活跃度计时均为进程内存态,
# 多 worker 会导致跨进程广播丢失、活跃房间被误判超时强杀

ExecStart=/opt/island_bells/backend/venv/bin/uvicorn \
    app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --log-level warning \
    --access-log

# 标准输出追加到日志文件
StandardOutput=append:/opt/island_bells/logs/backend.log
StandardError=append:/opt/island_bells/logs/backend-error.log

Restart=always
RestartSec=5

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/island_bells/backend/data /opt/island_bells/logs

[Install]
WantedBy=multi-user.target
